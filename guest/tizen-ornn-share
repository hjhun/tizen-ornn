#!/bin/sh
# Called before systemd, while no guest user processes can modify these paths.
set -eu
mode=$1
access=any
# Windows mapped-xattr records the uid from the creating 9p connection.
case "$mode" in
    rw:user|ro:user) mode=${mode%:user}; access=user ;;
esac
case "$mode" in rw|ro) ;; *) exit 1 ;; esac
target=/mnt/host
[ ! -L /mnt ] && mkdir -p /mnt || exit 1
# The stock emulator publishes /opt/mnt at /mnt during local-fs.target.
# Preserve files at its backing directory before the platform starts.
if [ -f /usr/lib/systemd/system/mnt.mount ] &&
    grep -Fxq 'What=/opt/mnt' /usr/lib/systemd/system/mnt.mount; then
    [ "$(readlink -f /opt/mnt)" = /opt/mnt ] && [ -d /opt/mnt ] || exit 1
    target=/opt/mnt/host
fi

# Verify the export first. A failed connection leaves the guest files in place.
stage=$(mktemp -d /run/tizen-share.XXXXXX)
options="$mode,trans=virtio,version=9p2000.L,cache=none,access=$access,nosuid,nodev"
mount -t 9p -o "$options,smackfsroot=User::Shell,smackfsdef=User::Shell" tizen-share "$stage"
mount_preserving_files() (
    operation=$1
    source=$2
    target=$3
    backup=
    if [ -L "$target" ] || { [ -e "$target" ] && [ ! -d "$target" ]; }; then
        occupied=yes
    elif [ -d "$target" ]; then
        occupied=$(find "$target" -mindepth 1 -maxdepth 1 -print -quit)
    else
        occupied=
    fi
    if [ -n "$occupied" ]; then
        backup=$target.before-host
        index=0
        while [ -e "$backup" ] || [ -L "$backup" ]; do
            index=$((index + 1))
            backup=$target.before-host.$index
        done
        mv -T -- "$target" "$backup"
        echo "tizen-ornn: preserved $target at $backup" >&2
    fi
    if ! mkdir -p -- "$target" || ! mount "$operation" "$source" "$target"; then
        if [ -n "$backup" ]; then
            if [ -d "$target" ]; then rmdir -- "$target"; fi
            mv -T -- "$backup" "$target"
        fi
        exit 1
    fi
)

mount_preserving_files --move "$stage" "$target"
rmdir -- "$stage"
if [ "$target" = /opt/mnt/host ]; then
    # PID 1 mounts the stock parent first and then exposes our staged export.
    units=/run/systemd/system
    mkdir -p "$units/local-fs.target.requires"
    cat > "$units/mnt-host.mount" <<'UNIT'
[Unit]
Description=Ornn host folder
Requires=mnt.mount
After=mnt.mount
[Mount]
What=/opt/mnt/host
Where=/mnt/host
Type=none
Options=bind
UNIT
    ln -s ../mnt-host.mount "$units/local-fs.target.requires/mnt-host.mount"
fi

# /home is a link to /opt/usr/home on the emulator. Only mount beneath
# a real account directory, never through a redirected home directory.
case "$(readlink -f /home/tizen)" in
    /opt/usr/home/tizen|/home/tizen)
        if [ -d /home/tizen ] && [ ! -L /home/tizen ]; then
            # Keep files on the root disk reachable without importing private
            # keys or overwriting an existing host workspace.
            mkdir -p /run/ornn-image-home
            mount --bind /home/tizen /run/ornn-image-home
            mount --bind "$target" /home/tizen
        fi ;;
esac
