[Unit]
Description=Local Tizen developer serial console
DefaultDependencies=no
Requires=tizen-dev-setup.service multi-user.target
After=tizen-dev-setup.service multi-user.target user@5001.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
SmackProcessLabel=System::Privileged
User=tizen
Group=tizen
WorkingDirectory=/home/tizen
Environment=HOME=/home/tizen USER=tizen LOGNAME=tizen TERM=xterm-256color
ExecStart=/bin/bash --login -i
Restart=always
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS0
TTYReset=yes
