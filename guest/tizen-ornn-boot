#!/bin/sh
# Run from the host-supplied fw_cfg file before the guest's systemd starts.
set -eu
config=/sys/firmware/qemu_fw_cfg/by_name/opt/tizen-ornn

mount -t proc -o nosuid,nodev,noexec proc /proc
mount -t tmpfs -o nosuid,nodev,noexec,mode=0755 tmpfs /run
# Match systemd's native Tizen /run before udev creates its device records.
chsmack -a System::Run -t /run
# udevadm runs as System and needs the guest policy to traverse System::Run.
dropin=/run/systemd/system/systemd-udev-trigger.service.d
mkdir -p "$dropin"
printf '[Unit]\nAfter=tizen-dev-setup.service\n' > "$dropin/tizen-ornn-policy.conf"

# Keep the package port accessible under the device name baked into older disks.
unit=/etc/systemd/system/tizen-guest-control.service
if [ -r "$unit" ]; then
    product=$(sed -n 's/^BindsTo=dev-tizen\\x2d\([a-z0-9][a-z0-9]*\)\\x2dpackages\.device$/\1/p' "$unit")
    if [ -n "$product" ] && [ "$product" != ornn ]; then
        mkdir -p /run/udev/rules.d
        printf 'SUBSYSTEM=="virtio-ports", ATTR{name}=="org.tizen.vm.packages", SYMLINK+="tizen-%s-packages"\n' "$product" > /run/udev/rules.d/89-tizen-ornn-compat.rules
    fi
fi

if [ -r "$config/graphics/raw" ]; then
    /bin/sh "$config/graphics/raw"
fi

if [ -r "$config/network/raw" ]; then
    /usr/bin/python3 -I "$config/network/raw"
fi

if [ -r "$config/share/raw" ]; then
    mode=$(tr -d '\000' < "$config/share/raw")
    /bin/sh "$config/share-script/raw" "$mode"
fi

# Preserve the historical path for explicit --share boots without hiding data there.
if [ -r "$config/owner-share/raw" ]; then
    legacy=/opt/usr/home/owner/host
    if [ "$(readlink -f "$legacy")" = "$legacy" ] && [ ! -L "$legacy" ]; then
        mkdir -p -- "$legacy"
        if [ -z "$(find "$legacy" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
            source=/mnt/host
            if [ -e /run/systemd/system/mnt-host.mount ]; then source=/opt/mnt/host; fi
            mount --bind "$source" "$legacy"
        fi
    fi
fi
