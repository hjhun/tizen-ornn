#!/bin/sh
# Run from the developer's login shell with the developer's own permissions.
set -eu
[ "$(id -un)" = tizen ] && [ "$HOME" = /home/tizen ] || exit 1
[ -w "$HOME" ] || exit 0
cd "$HOME"
# Install only shipped entries. Never traverse a host symlink as a directory.
sync_kit() (
    src=$1
    dest=$2
    [ ! -L "$dest" ] || { echo "Cannot install tools through $dest" >&2; exit 1; }
    mkdir -p -- "$dest"
    for entry in "$src"/* "$src"/.[!.]* "$src"/..?*; do
        [ -e "$entry" ] || continue
        target=$dest/${entry##*/}
        if [ -d "$entry" ]; then
            sync_kit "$entry" "$target"
        elif [ ! -L "$target" ] && [ -f "$target" ] &&
             cmp -s "$entry" "$target" &&
             { [ ! -x "$entry" ] || [ -x "$target" ]; }; then
            continue
        else
            # Publish a complete file even if two guests log in at the same time.
            tmp=$(mktemp "$dest/.ornn-tool.XXXXXXXX")
            trap 'rm -f -- "$tmp"' EXIT
            cp --preserve=mode -- "$entry" "$tmp"
            if [ -e "$target" ] || [ -L "$target" ]; then
                python3 -B /usr/share/tizen-dev/dev-setup/lib/setup_file.py \
                    --replace-closed "$tmp" "$target"
            else
                mv -T -- "$tmp" "$target"
            fi
            trap - EXIT
        fi
    done
)
sync_kit /usr/share/tizen-dev/dev-setup dev-setup
# Expose development workflows on first login, including a fresh developer home.
if [ ! -L .agents ] && [ ! -L .agents/skills ]; then
    mkdir -p .agents/skills
    for skill in ornn tizen-ornn-development; do
        if [ ! -e ".agents/skills/$skill" ] && [ ! -L ".agents/skills/$skill" ]; then
            ln -sT "../../dev-setup/skills/$skill" ".agents/skills/$skill" || [ -L ".agents/skills/$skill" ]
        fi
    done
fi
for file in bashrc bash_profile vimrc; do
    if [ -f "dev-setup/$file" ] && [ ! -e ".$file" ] && [ ! -L ".$file" ]; then
        ln -sT "dev-setup/$file" ".$file" || [ -L ".$file" ]
    fi
done
mkdir -p workspace
