#!/bin/sh
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
# The guest must never present an unlabelled development session.
mountpoint -q /sys/fs/smackfs || mount -t smackfs smackfs /sys/fs/smackfs
test -f /sys/fs/smackfs/load2
smackctl apply
# The single-disk VM does not run the stock platform-extension migration.
(
    # Some user-session variables in this platform file are unset at boot.
    set +u
    . /etc/tizen-platform.conf
    [ -d "$TZ_SYS_CRASH" ] ||
        exec /bin/bash -e /usr/share/platform-extension/210.crash-worker-platform-extension-migration.sh
) || echo 'tizen-ornn: could not initialize the crash report directories' >&2
ip link set lo up
for path in /sys/class/net/*; do
    name=${path##*/}
    if [ "$name" != lo ]; then
        ip link set "$name" up
        ip address replace 10.0.2.15/24 dev "$name"
        ip route replace default via 10.0.2.2 dev "$name"
        break
    fi
done
# The launcher can boot this image with either virtio or the legacy UART.
case " $(cat /proc/cmdline) " in
    *" console=hvc0 "*) console=/dev/hvc0 ;;
    *) console=/dev/ttyS0 ;;
esac
ln -sfn "$console" /run/tizen-dev-console
echo 'TizenDev local serial console ready'
