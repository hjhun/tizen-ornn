#!/bin/bash
set -euo pipefail
base=$HOME/dev-setup
export NPM_CONFIG_PREFIX=$base/cli NPM_CONFIG_CACHE=$base/cache/npm
export PATH=$base/cli/bin:$PATH
mkdir -p "$NPM_CONFIG_PREFIX/bin" "$NPM_CONFIG_CACHE"
if (( $# == 0 )); then set -- gemini claude codex; fi
for name do
    case "$name" in gemini|claude|codex) ;; *) echo "Unknown CLI: $name" >&2; exit 2;; esac
done
exec 9>"$base/.install.lock"
flock -x 9
install_claude() (
    options=(--global --no-audit --no-fund --allow-scripts=@anthropic-ai/claude-code)
    if [[ ! -d /run/ornn-image-home || $(findmnt -n -o FSTYPE -T "$base") != 9p ]]; then
        exec npm install "${options[@]}" @anthropic-ai/claude-code
    fi
    # npm retires its previous package directory during upgrades. Windows
    # 9p can refuse that cleanup, so run the package transaction on ext4.
    stage=$(mktemp -d /run/ornn-image-home/.ornn-npm.XXXXXXXX)
    pending=
    trap 'rm -rf -- "$stage"; if [[ -n $pending ]]; then rm -f -- "$pending"; fi' EXIT
    npm install --prefix "$stage" "${options[@]}" @anthropic-ai/claude-code
    "$stage/bin/claude" --version
    # Only publish a standalone ELF; a script could require the staging tree.
    [[ $(od -An -tx1 -N4 "$stage/bin/claude" | tr -d ' ') == 7f454c46 ]]
    mkdir -p "$base/cli/libexec"
    pending=$(mktemp "$base/cli/libexec/.claude.XXXXXXXX")
    install -m 755 "$stage/bin/claude" "$pending"
    python3 -B "$base/lib/setup_file.py" --replace-closed "$pending" "$base/cli/libexec/claude"
    pending=$pending.link
    ln -s ../../bin/claude "$pending"
    python3 -B "$base/lib/setup_file.py" --replace-closed "$pending" "$base/cli/bin/claude"
    pending=
)
for name do
    case "$name" in
        codex) npm install --global --no-audit --no-fund @openai/codex ;;
        claude) install_claude ;;
        gemini) npm install --global --no-audit --no-fund @google/gemini-cli ;;
    esac
    if [[ $name == claude ]]; then
        "$base/bin/claude" --version
    else
        "$NPM_CONFIG_PREFIX/bin/$name" --version
    fi
    if [[ $name == claude ]]; then "$base/bin/setup-claude-statusline"; fi
done
