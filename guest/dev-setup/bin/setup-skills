#!/bin/bash
set -eu
mkdir -p "$HOME/dev-setup/skills/herdr"
tmp=$(mktemp /tmp/ornn-skill.XXXXXXXX)
trap 'rm -f -- "$tmp"' EXIT
"$HOME/dev-setup/cli/bin/herdr" --skill > "$tmp"
python3 "$HOME/dev-setup/lib/setup_file.py" "$tmp" "$HOME/dev-setup/skills/herdr/SKILL.md"
for dir in "$HOME/.agents/skills" "$HOME/.agent/skills" "$HOME/.claude/skills"; do
    mkdir -p "$dir"
    for name in coding-style development-style graphify herdr ornn tizen-ornn-development; do
        source_dir=$HOME/dev-setup/skills/$name
        test -r "$source_dir/SKILL.md"
        if [[ "$dir/$name" -ef "$source_dir" ]]; then continue; fi
        if [[ -e "$dir/$name" || -L "$dir/$name" ]]; then
            echo "Existing skill requires manual merging: $dir/$name" >&2
            exit 1
        fi
        ln -s "$source_dir" "$dir/$name"
    done
done
