#!/bin/sh
set -eu
install -d -m 0700 -o tizen -g tizen /run/tizen-dev-ui
chsmack -a 'User::Shell' -t /run/tizen-dev-ui
# The emulator skeleton carries the floor label on these writable user paths.
# Apply the development user's domain to its own configuration and cache roots.
mountpoint -q /home/tizen && exit 0
for path in /home/tizen/.cache /home/tizen/.config; do
    if mountpoint -q "$path"; then continue; fi
    if [ -d "$path" ] && [ "$(stat -c %u "$path")" = "$(id -u tizen)" ]; then
        chsmack -a 'User::Shell' -t "$path"
    fi
done
