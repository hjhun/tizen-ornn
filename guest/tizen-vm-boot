#!/bin/sh
# Run from the host-supplied fw_cfg file before the guest's systemd starts.
set -eu
config=/sys/firmware/qemu_fw_cfg/by_name/opt/tizen-vm

mount -t proc -o nosuid,nodev,noexec proc /proc
mount -t tmpfs -o nosuid,nodev,noexec,mode=0755 tmpfs /run
# Match systemd's native Tizen /run before udev creates its device records.
chsmack -a System::Run -t /run

if [ -r "$config/graphics/raw" ]; then
    /bin/sh "$config/graphics/raw"
fi

if [ -r "$config/network/raw" ]; then
    /usr/bin/python3 -I "$config/network/raw"
fi

if [ -r "$config/share/raw" ]; then
    mode=$(tr -d '\000' < "$config/share/raw")
    case "$mode" in
        rw|ro) ;;
        *) echo 'tizen-vm: invalid host share access mode' >&2; exit 1 ;;
    esac
    target=/opt/usr/home/owner/host
    if [ -L "$target" ] || [ "$(readlink -f "$target")" != "$target" ]; then
        echo 'tizen-vm: the guest share path contains a symbolic link' >&2
        exit 1
    fi
    if [ -d "$target" ]; then
        if [ -n "$(find "$target" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
            echo 'tizen-vm: /home/owner/host must be empty before mounting' >&2
            exit 1
        fi
    else
        mkdir -m 0555 "$target"
    fi
    options="$mode,trans=virtio,version=9p2000.L,cache=none,access=any,nosuid,nodev"
    mount -t 9p -o "$options,smackfsroot=User::Shell,smackfsdef=User::Shell" tizen-share "$target"
fi
