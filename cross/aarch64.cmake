set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_SYSROOT /opt/tizen/sysroots/aarch64)
set(CMAKE_C_COMPILER /usr/bin/tizen-aarch64-gcc)
set(CMAKE_CXX_COMPILER /usr/bin/tizen-aarch64-g++)
set(PKG_CONFIG_EXECUTABLE /usr/bin/tizen-aarch64-pkg-config CACHE FILEPATH "ARM pkg-config")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_CROSSCOMPILING_EMULATOR /usr/bin/qemu-aarch64;-L;${CMAKE_SYSROOT})
