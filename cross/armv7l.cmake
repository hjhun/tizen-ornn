set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7l)
set(CMAKE_SYSROOT /opt/tizen/sysroots/armv7l)
set(CMAKE_C_COMPILER /usr/bin/tizen-armv7l-gcc)
set(CMAKE_CXX_COMPILER /usr/bin/tizen-armv7l-g++)
set(PKG_CONFIG_EXECUTABLE /usr/bin/tizen-armv7l-pkg-config CACHE FILEPATH "ARM pkg-config")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_CROSSCOMPILING_EMULATOR /usr/bin/qemu-arm;-L;${CMAKE_SYSROOT})
