#!/bin/bash
set -euo pipefail
out=${1:?supply ARM image directory}
case ${TIZEN_ARM_ARCH:-armv7l} in
    armv7l) tool=qemu-system-arm; cpu=cortex-a15; kernel=zImage ;;
    aarch64) tool=qemu-system-aarch64; cpu=cortex-a72; kernel=Image ;;
    *) exit 2 ;;
esac
qemu=${TIZEN_ARM_QEMU:-$tool}
if ! command -v "$qemu" >/dev/null && [[ -x $out/cache/qemu/usr/bin/$tool ]]; then
    qemu=$out/cache/qemu/usr/bin/$tool
fi
[[ -s $out/$kernel && -s $out/disk/hal.img ]] || { echo 'Prepare the selected ARM headed image first.' >&2; exit 1; }
exec 9>"$out/build.lock"
flock -n -x 9 || { echo 'The ARM VM is already running or building.' >&2; exit 1; }
args=()
# Keep Linux vda through vdd stable independently of QEMU's automatic placement.
parts=(rootfs system-data user hal)
for slot in "${!parts[@]}"; do
    img=${parts[$slot]}
    path=$out/disk/$img.img
    args+=(-drive "if=none,format=raw,id=$img,file=${path//,/,,}" -device "virtio-blk-device,drive=$img,bus=virtio-mmio-bus.$slot")
done
prefix=$("$(dirname "$0")/../vm-runtime" "$out/build.lock")
# Keep the guest end connected even when no shutdown client is present.
# The per-image lock serializes creation and cleanup of these private FIFOs.
for fifo in "$prefix.shutdown.in" "$prefix.shutdown.out"; do
    if [[ ! -p $fifo ]]; then mkfifo -m 600 "$fifo"; fi
done
trap 'rm -f -- "$prefix.shutdown.in" "$prefix.shutdown.out"' EXIT
args+=(-chardev "pipe,id=ornnpower,path=$prefix.shutdown" -device virtio-serial-device,id=armserial
       -device virtserialport,bus=armserial.0,chardev=ornnpower,name=org.tizen.ornn.power)
args+=(-qmp "unix:$prefix.power,server=on,wait=off")
if [[ -n ${TIZEN_QMP:-} ]]; then args+=(-qmp "unix:${TIZEN_QMP//,/,,},server=on,wait=off"); fi
display=${TIZEN_ARM_DISPLAY:-sdl,gl=on}
gpu=virtio-gpu-device
case ",$display," in
    *,gl=on,*) gpu=virtio-gpu-gl-device,xres=1024,yres=768 ;;
esac
# The GPU and input devices require the modern virtio-mmio transport.
"$qemu" -machine virt -global virtio-mmio.force-legacy=false -cpu "$cpu" -accel tcg -m "${TIZEN_RAM:-3072}" -smp "${TIZEN_CPUS:-2}" \
    -kernel "$out/$kernel" -append 'root=/dev/vda rootfstype=ext4 rootwait rw console=ttyAMA0,115200 systemd.unit=graphical.target' \
    "${args[@]}" -display "$display" -device "$gpu" \
    -device virtio-keyboard-device -device virtio-tablet-device -device virtio-rng-device \
    -netdev user,id=net -device virtio-net-device,netdev=net -serial stdio -monitor none
