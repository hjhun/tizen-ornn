#!/bin/bash
set -euo pipefail
out=${1:?supply ARM image directory}
case ${TIZEN_ARM_ARCH:-armv7l} in
    armv7l) tool=qemu-system-arm; cpu=cortex-a15; kernel=zImage ;;
    aarch64) tool=qemu-system-aarch64; cpu=cortex-a72; kernel=Image ;;
    *) exit 2 ;;
esac
qemu=${TIZEN_ARM_QEMU:-$tool}
if ! command -v "$qemu" >/dev/null && [[ -x $out/cache/qemu/usr/bin/$tool ]]; then
    qemu=$out/cache/qemu/usr/bin/$tool
fi
[[ -s $out/$kernel && -s $out/disk/hal.img ]] || { echo 'Prepare the selected ARM headed image first.' >&2; exit 1; }
exec 9>"$out/build.lock"
flock -n -x 9 || { echo 'The ARM VM is already running or building.' >&2; exit 1; }
args=()
for img in rootfs system-data user hal; do
    path=$out/disk/$img.img
    args+=(-drive "if=none,format=raw,id=$img,file=${path//,/,,}" -device "virtio-blk-device,drive=$img")
done
prefix=$("$(dirname "$0")/../vm-runtime" "$out/build.lock")
args+=(-qmp "unix:$prefix.power,server=on,wait=off")
if [[ -n ${TIZEN_QMP:-} ]]; then args+=(-qmp "unix:${TIZEN_QMP//,/,,},server=on,wait=off"); fi
exec "$qemu" -machine virt -cpu "$cpu" -accel tcg -m "${TIZEN_RAM:-1536}" -smp "${TIZEN_CPUS:-2}" \
    -kernel "$out/$kernel" -append 'root=/dev/vda rootfstype=ext4 rootwait rw console=ttyAMA0,115200 systemd.unit=graphical.target' \
    "${args[@]}" -display "${TIZEN_ARM_DISPLAY:-sdl}" -device virtio-gpu-device \
    -device virtio-keyboard-device -device virtio-tablet-device -device virtio-rng-device \
    -netdev user,id=net -device virtio-net-device,netdev=net -serial stdio -monitor none -no-reboot
