#!/bin/bash
# Prepare the writable Tizen headed partitions for a QEMU virt board.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
out=$(realpath -m -- "${1:?supply ARM image directory}")
arch=${TIZEN_ARM_ARCH:-armv7l}
case $arch in
    armv7l) kernel=zImage ;;
    aarch64) kernel=Image ;;
    *) echo "Unsupported ARM architecture: $arch" >&2; exit 2 ;;
esac
mkdir -p "$out"
exec 9>"$out/build.lock"
flock -n 9 || { echo 'ARM image is being prepared or used.' >&2; exit 1; }
scratch=$(mktemp -d "$out/.arm-build.XXXXXXXX")
trap 'rm -rf -- "$scratch"' EXIT
if [[ ! -d $out/disk ]]; then
    stage=$scratch/partitions
    mkdir "$stage"
    release=$("$here/../tizen-image" --print-snapshot)
    base=$("$here/../tizen-image" --print-source)Tizen-10.1-Unified/$release/images/standard
    fetch() {
        local name=$1 dest=$scratch/$2.tar.gz file=${release}_$1.tar.gz digest
        digest=$(curl -fLSs --retry 2 "$base/$name/SHA256SUMS" | awk -v f="$file" '$2 == f {print $1}')
        [[ $digest =~ ^[0-9a-f]{64}$ ]] || { echo "Missing or ambiguous checksum for $file" >&2; return 1; }
        curl -fLSs --retry 2 "$base/$name/${release}_$name.tar.gz" -o "$stage/download"
        echo "$digest  $stage/download" | sha256sum -c -
        mv -- "$stage/download" "$dest"
    }
    fetch "tizen-headed-$arch" headed
    fetch "tizen-$arch-generic-hal" hal
    tar -xSzf "$scratch/headed.tar.gz" -C "$stage" rootfs.img system-data.img user.img
    tar -xSzf "$scratch/hal.tar.gz" -C "$stage" hal.img
    # The board ramdisk normally mounts these before systemd starts. QEMU
    # boots a direct kernel. Use the original filesystem labels and types.
    cat > "$stage/fstab" <<'FSTAB'
LABEL=rootfs / ext4 defaults 0 0
LABEL=system-data /opt ext4 defaults 0 0
LABEL=user /opt/usr f2fs defaults 0 0
LABEL=hal /hal ext4 defaults 0 0
FSTAB
    debugfs -w -R "write $stage/fstab /etc/fstab" "$stage/rootfs.img"
    debugfs -R 'cat /etc/fstab' "$stage/rootfs.img" | cmp - "$stage/fstab"
    rm -- "$stage/fstab"
    "$here/install-mounts" "$stage/rootfs.img"
    "$here/install-power-button" "$stage/rootfs.img"
    "$here/install-graphics" "$stage/rootfs.img" "$arch"
    "$here/install-audio" "$stage/rootfs.img" "$stage/hal.img" "$arch"
    for img in rootfs system-data; do
        truncate -s "+${TIZEN_ARM_DISK_GROW:-2G}" "$stage/$img.img"
        resize2fs "$stage/$img.img"
        e2fsck -fn "$stage/$img.img"
    done
    mv -T "$stage" "$out/disk"
fi
if [[ ${2:-} == --disks-only ]]; then exit 0; fi
if [[ ! -s $out/$kernel ]]; then
    "$here/build-kernel" "$scratch"
    mv "$scratch/$kernel" "$out/$kernel"
fi
