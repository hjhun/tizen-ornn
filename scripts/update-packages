#!/usr/bin/python3
"""Prepare verified native RPM indexes and send them to the running Tizen VM."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import tarfile
import tempfile

here = Path(__file__).resolve().parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("disk", type=Path)
parser.add_argument("--snapshot", default="latest")
parser.add_argument("packages", nargs="*")
args = parser.parse_intermixed_args()
if any(not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9+._-]{0,199}", name) for name in args.packages):
    parser.error("expected RPM names without paths or version expressions")

# A managed QEMU process holds the guest disk exclusively until poweroff.
prefix = subprocess.check_output([here / "vm-runtime", args.disk], text=True).strip()
with args.disk.open("rb") as disk:
    try:
        fcntl.flock(disk, fcntl.LOCK_SH | fcntl.LOCK_NB)
        running = False
    except BlockingIOError:
        running = Path(prefix + ".packages").is_socket()
if not running:
    parser.exit(1, "Start the selected VM with tizen-vm run before updating its packages.\n")

with tempfile.TemporaryDirectory(prefix="tizen-rpm-update-") as tmp:
    work = Path(tmp)
    root = work / "root"
    lock = work / "snapshot.lock.json"
    with lock.open("wb") as out:
        subprocess.run([here / "tizen-image", "--print-lock", "--snapshot", args.snapshot], stdout=out, check=True)
    env = dict(os.environ, TIZEN_SNAPSHOT_LOCK=str(lock), PYTHONDONTWRITEBYTECODE="1")
    subprocess.run([here / "prepare-zypp.py", root], env=env, check=True)
    (root / "packages.json").write_text(json.dumps(args.packages))
    bundle = work / "native.tar.gz"
    with tarfile.open(bundle, "w:gz", compresslevel=1) as archive:
        for file in sorted(root.rglob("*")):
            if file.is_file():
                archive.add(file, arcname=file.relative_to(root), recursive=False)
    print(f"Updating guest packages from {json.loads(lock.read_text())['release']} "
          f"({bundle.stat().st_size:,} bytes of signed repository metadata)", flush=True)
    result = subprocess.run([here / "guest-command", args.disk, "update", bundle])
    raise SystemExit(result.returncode)
