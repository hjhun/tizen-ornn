#!/usr/bin/env python3
"""Tizen Ornn builds, runs and updates a Tizen development VM."""
from types import SimpleNamespace
from contextlib import contextmanager, nullcontext
import fcntl
import hashlib
import json
import os
import pwd
from pathlib import Path
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
SCRIPTS = ROOT / 'scripts'
BUILDER = SCRIPTS / 'tizen-image'
sys.path.insert(0, str(SCRIPTS))
from image_source import ImageSource, config_path, user_config


def legacy_store():
    if os.environ.get('TIZEN_OUT'):
        return Path(os.environ['TIZEN_OUT']).expanduser().resolve()
    if ROOT != Path('/usr/lib/tizen-ornn'):
        return ROOT / 'out'
    return None


def configured_home():
    return os.environ.get('TIZEN_ORNN_HOME') or os.environ.get('TIZEN_VM_HOME')


def data_home():
    if configured_home():
        return Path(configured_home()).expanduser().resolve()
    legacy = legacy_store()
    xdg = Path(os.environ.get('XDG_DATA_HOME') or Path.home() / '.local/share') / 'tizen-ornn'
    old = xdg.with_name('tizen-vm')
    if not xdg.exists() and old.is_dir():
        xdg = old
    if legacy is None:
        return xdg
    parent = legacy
    while not parent.exists():
        parent = parent.parent
    if os.access(parent, os.W_OK):
        return legacy
    # A sudo-built legacy output can be read-only. Keep distinct installations
    # separate while managing each one's future versions under the user's home.
    return xdg / 'imports' / hashlib.sha256(os.fsencode(legacy)).hexdigest()[:16]


def disk_at(image):
    for name in ('tizen-rootfs.ext4', 'tizen-rootfs.qcow2'):
        disk = image / name
        if disk.is_file() and (image / 'bzImage').is_file():
            if (image / '.root-work').exists() and not (image / '.image-ready').is_file():
                raise ValueError(f'Image build is incomplete at {image}.')
            return disk
    raise ValueError(f'Missing Tizen kernel or disk in {image}.')


def selection_link(home):
    current = home / 'current'
    if (home / '.tizen-current').is_symlink() or (current.is_dir() and not current.is_symlink()):
        return home / '.tizen-current'
    return current


def active_image(home):
    current = selection_link(home)
    if current.is_symlink() or current.exists():
        image = current.resolve(strict=True)
        disk_at(image)
        return image
    for image in (home / 'current', home / 'dev', home):
        if (image / 'bzImage').is_file():
            disk_at(image)
            return image.resolve()
    # Older sudo-based instructions could leave the checkout's out/ read-only.
    # Keep using that disk until the first update, then write to the user's store.
    legacy = legacy_store()
    if not configured_home() and legacy and legacy != home and legacy.is_dir():
        return active_image(legacy)
    return None


def launch_choices(home):
    """Return complete installed images, with the current selection first."""
    try:
        current = active_image(home)
    except (ValueError, FileNotFoundError):
        current = None
    candidates = [current, home / 'current', home / 'dev']
    images = home / 'images'
    if images.is_dir() and not images.is_symlink():
        candidates.extend(path for path in sorted(images.iterdir())
                          if not path.name.startswith('.') and not path.is_symlink())
    choices = []
    seen = set()
    for path in candidates:
        if path is None or not path.is_dir():
            continue
        try:
            disk = disk_at(path).resolve()
        except ValueError:
            continue
        if disk not in seen:
            choices.append(('x86_64', path.resolve()))
            seen.add(disk)
    for arch, kernel in ARM_KERNELS.items():
        arm = home / f'{arch}-headed'
        files = [arm / kernel, *(arm / 'disk' / (name + '.img') for name in ARM_PARTITIONS)]
        if all(path.is_file() and path.stat().st_size for path in files):
            choices.append((arch, arm))
    return choices


def update_choices(home):
    choices = [item for item in launch_choices(home) if item[0] == 'x86_64']
    for arch in ARM_KERNELS:
        if not (home / f'{arch}-headed' / 'disk').is_dir():
            continue
        if not choices:
            raise ValueError(f'{arch} image and package updates are not supported yet.')
        print(f'{arch}-headed: image and package updates are not supported yet.')
    return choices


def choose_image(choices, action, prompt_single=False):
    if len(choices) == 1 and not prompt_single:
        return choices[0]
    print(f'Select a Tizen Ornn VM image to {action}:')
    for index, (arch, image) in enumerate(choices, 1):
        print(f'  {index}. {arch}  {image.name}')
    while True:
        try:
            answer = input('Image [1], q to cancel: ').strip()
        except EOFError:
            return None
        if answer.lower() == 'q':
            return None
        if not answer:
            return choices[0]
        for index, choice in enumerate(choices, 1):
            if answer == str(index):
                return choice
        print(f'Enter a number from 1 to {len(choices)}.')


@contextmanager
def lock_file(path, description, create=False):
    with path.open('a' if create else 'rb') as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError(description) from None
        yield


def stopped(image):
    return lock_file(disk_at(image), 'The image is in use. Run systemctl poweroff in the guest and retry.')


def select(home, image, previous):
    # One rename publishes both choices. Readers of current see the complete old
    # generation or the complete new one, including after an interrupted update.
    states = home / '.tizen-selections'
    states.mkdir(exist_ok=True)
    generation = Path(tempfile.mkdtemp(prefix='selection-', dir=states))
    (generation / 'image').symlink_to(os.path.relpath(image, generation))
    if previous:
        (generation / 'previous').symlink_to(os.path.relpath(previous, generation))
    # Compute the target relative to the final location of the symlink.
    link = generation / 'next'
    link.symlink_to(os.path.relpath(generation / 'image', home))
    link.replace(selection_link(home))


def run_as_root(cmd, *, build_network=False):
    prefix = [] if os.geteuid() == 0 else ['sudo']
    if prefix and build_network:
        names = ('http_proxy', 'https_proxy', 'all_proxy', 'no_proxy')
        keys = [key for name in names for key in (name, name.upper()) if key in os.environ]
        if keys:
            prefix.append('--preserve-env=' + ','.join(keys))
    subprocess.run([*prefix, *cmd], check=True)


def dependencies(build, gui=False):
    runtime, tools, kernel_tools = (ROOT / 'config/host-packages').read_text().splitlines()
    packages = runtime.split()
    if gui:
        packages.append('qemu-system-gui')
    # The portable host-tools extraction used by the launcher also supplies QEMU.
    private = ROOT / 'out/host-tools/usr'
    if all((private / name).is_file() for name in
           ('bin/qemu-system-x86_64', 'bin/qemu-img', 'share/seabios/bios-256k.bin')):
        packages = [p for p in packages if p not in ('qemu-system-x86', 'qemu-system-gui', 'qemu-utils', 'seabios')]
    if build:
        packages += tools.split()
        if os.environ.get('TIZEN_PREBUILT_KERNEL', '1') != '1':
            packages += kernel_tools.split()
    query = subprocess.run(['dpkg-query', '-W', '-f=${Package} ${db:Status-Status}\n', *packages],
                           text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    installed = {line.split()[0] for line in query.stdout.splitlines() if line.endswith(' installed')}
    missing = [p for p in packages if p not in installed]
    if missing:
        run_as_root(['apt-get', 'update'], build_network=build)
        run_as_root(['apt-get', 'install', '-y', *missing], build_network=build)


def requested_image(snapshot):
    source = ImageSource.load()
    return source.resolve(snapshot), source.base_url


def configure(repository, snapshot):
    path = config_path()
    if repository is not None or snapshot is not None:
        dest = user_config()
        dest.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        with lock_file(dest.with_name('.image-config.lock'), 'Another configuration edit is in progress.', create=True):
            # An explicitly selected new file inherits the packaged defaults.
            initial = config_path()
            previous = ImageSource.load(initial if initial.exists() else ROOT / 'config/image.toml')
            source = ImageSource.validated(repository if repository is not None else previous.base_url,
                                           snapshot if snapshot is not None else previous.snapshot, dest, previous.profile)
            with tempfile.NamedTemporaryFile(dir=dest.parent, mode='w', delete=False) as tmp:
                pending = Path(tmp.name)
                try:
                    tmp.write(f'repository = {json.dumps(source.base_url)}\nsnapshot = {json.dumps(source.snapshot)}\n')
                    tmp.write(f'profile = {json.dumps(source.profile)}\n')
                    tmp.flush()
                    os.fsync(tmp.fileno())
                    pending.replace(dest)
                finally:
                    pending.unlink(missing_ok=True)
        path = dest
    source = ImageSource.load(path)
    print(f'Configuration: {path}\nRepository: {source.base_url}\nSnapshot: {source.snapshot}')


def matches(image, release, source, revision, archive=None):
    marker = image / '.tizen-ornn-image-revision'
    if not marker.exists():
        marker = image / '.tizen-vm-image-revision'
    path = image / 'snapshot.lock.json'
    if not marker.is_file() or marker.read_text().strip() != revision or not path.is_file():
        return False
    lock = json.loads(path.read_text())
    archive_url = lock.get('archive', {}).get('url', '')
    if archive and archive_url != archive:
        return False
    return lock.get('release') == release and archive_url.startswith(f'{source}Tizen-10.1-Unified/{release}/')


def build_image(stage, release, config=None):
    settings = {'TIZEN_PREBUILT_KERNEL': os.environ.get('TIZEN_PREBUILT_KERNEL', '1')}
    for key in ('TIZEN_FS_SIZE', 'JOBS'):
        if key in os.environ:
            settings[key] = os.environ[key]
    if os.environ.get('TIZEN_BUILD_CA_CERT'):
        settings['TIZEN_BUILD_CA_CERT'] = str(Path(os.environ['TIZEN_BUILD_CA_CERT']).resolve(strict=True))
    settings['TIZEN_IMAGE_CONFIG'] = str((config or config_path()).resolve(strict=True))
    cmd = ['env', *(f'{key}={val}' for key, val in settings.items()), BUILDER,
           '--snapshot', release, '--out', stage]
    run_as_root(cmd, build_network=True)


def prepare(home, active, snapshot, *, name=None, previous=None, config=None):
    if config:
        settings = ImageSource.load(config)
        release, source = settings.snapshot, settings.base_url
    else:
        release, source = requested_image(snapshot)
    revision = (ROOT / 'config/image-revision').read_text().strip()
    archive = settings.archive_url(release) if config else None
    if active and matches(active, release, source, revision, archive):
        print(f'Already up to date: {release} ({active})')
        return
    with stopped(active) if active else nullcontext():
        dependencies(build=True)
        images = home / 'images'
        images.mkdir(exist_ok=True)
        identity = archive or source
        if os.environ.get('TIZEN_BUILD_CA_CERT'):
            from build_ca import certificate
            identity += hashlib.sha256(certificate()).hexdigest()
        key = hashlib.sha256(identity.encode()).hexdigest()[:12]
        stem = f'{release}-v{revision}-{key}'
        if name and os.path.lexists(images / name):
            raise ValueError(f'Image already exists: {images / name}')
        stage = images / (f'.building-{stem}-{name}' if name else f'.building-{stem}')
        if stage.is_symlink():
            raise ValueError(f'Expected an image build directory at {stage}.')
        # A failed merge can be resumed with the same source disk. If it has
        # since been edited or replaced, avoid inheriting files left by that
        # earlier attempt. The unselected partial image remains recoverable.
        migration_id = None
        if active:
            old_disk = disk_at(active)
            attrs = old_disk.stat()
            migration_id = f'{old_disk}\n{attrs.st_dev}:{attrs.st_ino}:{attrs.st_size}:{attrs.st_mtime_ns}:{attrs.st_ctime_ns}'
        attempt = stage / '.migration-source'
        if attempt.exists() and attempt.read_text() != migration_id:
            partial = Path(tempfile.mkdtemp(prefix='.partial-migration-', dir=images)) / 'image'
            stage.rename(partial)
            print(f'Previous partial migration retained at {partial}.')
        stage.mkdir(exist_ok=True)
        if not (stage / '.image-ready').is_file():
            if config:
                build_image(stage, release, config)
            else:
                build_image(stage, release)
        if not (stage / '.image-ready').is_file() or not matches(stage, release, source, revision, archive):
            raise ValueError(f'Built image does not match the requested source and revision: {stage}')
        new_disk = disk_at(stage)
        with stopped(stage):
            if active:
                attempt.write_text(migration_id)
                print('Copying Tizen user data and home directories to the new disk...', flush=True)
                run_as_root(['unshare', '--mount', '--propagation', 'private',
                             SCRIPTS / 'copy-workspace.sh', disk_at(active), new_disk])
            target = images / (name or stem)
            number = 1
            while target.exists() or target.is_symlink():
                number += 1
                target = images / f'{stem}-{number}'
            stage.rename(target)
            select(home, target, active or previous)
    print(f'Selected {release} in {target}')
    if active:
        print(f'Previous disk retained at {active}. Run tizen-ornn rollback to use it.')


ARM_KERNELS = {'armv7l': 'zImage', 'aarch64': 'Image'}
ARM_PARTITIONS = ('rootfs', 'system-data', 'user', 'hal')


def deletable_images(home, arch):
    images = home / 'images'
    choices = []
    if arch in (None, 'x86_64') and images.is_dir() and not images.is_symlink():
        for path in sorted(images.iterdir()):
            if path.name.startswith('.') or path.is_symlink() or not path.is_dir():
                continue
            try:
                disk_at(path)
            except ValueError:
                continue
            choices.append(('x86_64', path))
    for target in ARM_KERNELS:
        arm = home / f'{target}-headed'
        directory = arm / 'disk'
        if (arch in (None, target) and not arm.is_symlink() and not directory.is_symlink()
                and all((directory / f'{part}.img').is_file() for part in ARM_PARTITIONS)):
            choices.append((target, arm))
    return choices


def confirm_delete(path, name, yes):
    if yes:
        return
    try:
        if sys.stdin.isatty():
            answer = input(f'Delete {path}? Type y, yes, or {name} to confirm: ')
            if answer == name or answer.strip().lower() in ('y', 'yes'):
                return
    except EOFError:
        pass
    raise ValueError('Deletion cancelled. For non-interactive use specify --yes.')


def check_disk_unused(images, disk):
    loops = subprocess.check_output(['losetup', '-j', disk], text=True)
    if loops.strip() or os.path.ismount(disk.parent) or os.path.ismount(disk):
        raise ValueError('The image is mounted or attached to a loop device.')
    for overlay in images.glob('*/tizen-rootfs.qcow2'):
        if overlay == disk:
            continue
        info = subprocess.check_output(['qemu-img', 'info', '-U', '--output=json',
                                        '--backing-chain', str(overlay)], text=True)
        for layer in json.loads(info):
            backing = layer.get('full-backing-filename')
            if backing and Path(backing).resolve() == disk:
                raise ValueError(f'{overlay} uses this disk as a backing image.')


def delete_arm(home, image, yes):
    directory = image / 'disk'
    parts = [directory / f'{part}.img' for part in ARM_PARTITIONS]
    with lock_file(image / 'build.lock', 'ARM image is in use.', create=True):
        if (image.is_symlink() or directory.is_symlink() or os.path.ismount(directory)
                or set(directory.iterdir()) != set(parts)):
            raise ValueError(f'Unexpected ARM partition directory: {directory}')
        for part in parts:
            if part.is_symlink() or not part.is_file():
                raise ValueError(f'Expected a regular partition: {part}')
            check_disk_unused(home / 'images', part)
        confirm_delete(directory, image.name, yes)
        # Detach the entire partition set before removing any individual file.
        with tempfile.TemporaryDirectory(dir=image, prefix='.deleting-') as tmp:
            directory.rename(Path(tmp) / 'disk')
    print(f'Deleted {directory}')


def delete_image(home, active, name, yes):
    images = home / 'images'
    if name.startswith('.') or Path(name).name != name or images.is_symlink():
        raise ValueError('Use one image directory name from the managed images directory.')
    image = images / name
    if image.is_symlink() or not image.is_dir():
        raise ValueError(f'No managed image named {name}.')
    disk = disk_at(image)
    if disk.is_symlink() or all((image / f'tizen-rootfs.{ext}').exists()
                               for ext in ('ext4', 'qcow2')):
        raise ValueError('Expected one regular disk in the image directory.')
    link = selection_link(home)
    previous = None
    if link.is_symlink():
        generation = (home / os.readlink(link)).parent
        if generation.parent == home / '.tizen-selections':
            candidate = generation / 'previous'
            if candidate.is_dir():
                previous = candidate.resolve()
    with stopped(image):
        check_disk_unused(images, disk)
        confirm_delete(disk, name, yes)
        if active == image:
            if previous and previous != image:
                disk_at(previous)
                select(home, previous, None)
            elif link.is_symlink():
                link.unlink()
        elif previous == image:
            select(home, active, None)
        disk.unlink()
    print(f'Deleted {disk}')


def rollback(home, active):
    current = selection_link(home)
    if not active or not current.is_symlink():
        raise ValueError('No previous image is recorded.')
    generation = (home / os.readlink(current)).parent
    if generation.parent != home / '.tizen-selections' or not (generation / 'previous').is_symlink():
        raise ValueError('No previous image is recorded.')
    previous = (generation / 'previous').resolve(strict=True)
    with stopped(active), stopped(previous):
        select(home, previous, active)
    print(f'Selected previous image at {previous}. The other disk is still at {active}.')


def execute(args):
    # Even when invoked via sudo, the VM and its selection belong to the
    # developer. Elevate only the package installation and filesystem build.
    if os.geteuid() == 0 and os.environ.get('SUDO_UID', '0') != '0':
        account = pwd.getpwuid(int(os.environ['SUDO_UID']))
        os.initgroups(account.pw_name, account.pw_gid)
        os.setgid(account.pw_gid)
        os.setuid(account.pw_uid)
        os.environ.update(HOME=account.pw_dir, USER=account.pw_name, LOGNAME=account.pw_name)
    headless = args.headless
    if args.command == 'images':
        print(json.dumps([{'arch': arch, 'path': str(path)}
                          for arch, path in launch_choices(data_home().resolve())]))
        return
    picked = Path(args.directory).resolve(strict=True) if args.directory else None
    if (args.pick and sys.stdin.isatty() and sys.stdout.isatty()
            and not any(os.environ.get(key) for key in ('TIZEN_OUT', 'TIZEN_DISK', 'TIZEN_KERNEL'))):
        choices = launch_choices(data_home().resolve())
        if choices:
            choice = choose_image(choices, 'launch')
            if choice is None:
                return
            args.arch, picked = choice
    if picked and args.command in (None, 'run', 'start'):
        arch = next((arch for arch, kernel in ARM_KERNELS.items() if (picked / kernel).is_file()), 'x86_64')
        if args.arch and args.arch != arch:
            raise ValueError(f'Expected a {args.arch} image at {picked}, found {arch}.')
        args.arch = arch
    if args.command == 'console':
        lock = picked / 'build.lock' if any((picked / k).is_file() for k in ARM_KERNELS.values()) else disk_at(picked)
        prefix = subprocess.check_output([SCRIPTS / 'vm-runtime', lock], text=True).strip()
        os.environ.pop('TMUX', None)
        os.environ.pop('TMUX_PANE', None)
        os.execvp('tmux', ['tmux', '-S', prefix + '.sock', 'attach-session', '-t', '=vm'])
    if args.arch in ARM_KERNELS and args.command != 'delete':
        if getattr(args, 'name', None) or getattr(args, 'build_config', None):
            raise ValueError('Building a named repository image requires x86_64')
        if headless or args.command not in (None, 'run', 'start', 'build'):
            raise ValueError('ARM currently supports build and graphical run/start')
        if any(getattr(args, key, False) for key in ('share', 'share_ro', 'host_browser', 'no_host_network')):
            raise ValueError('these host integration options currently require x86_64')
        os.environ['TIZEN_ARM_ARCH'] = args.arch
        arm_home = data_home() / f'{args.arch}-headed'
        tool = SCRIPTS / 'armv7l' / ('build-image' if args.command == 'build' else 'run')
        image = picked or arm_home
        if args.command != 'build' and sys.stdin.isatty() and sys.stdout.isatty():
            lock = image / 'build.lock'
            lock.touch(exist_ok=True)
            session = SCRIPTS / 'console-session'
            os.execv(session, [session, lock, '', '0', '0', tool, image])
        os.execv(tool, [str(tool), str(image)])
    if args.command == 'config':
        configure(args.repository, args.snapshot)
        return
    home = data_home().resolve()
    explicit = os.environ.get('TIZEN_OUT') if configured_home() else None
    if explicit and Path(explicit).expanduser().resolve() == home:
        explicit = None
    if args.command in (None, 'start', 'run'):
        image = picked or (Path(explicit) if explicit else active_image(home))
        if picked is not None:
            # A one-time menu choice can differ from the update/rollback target.
            os.environ['TIZEN_DISK'] = str(disk_at(picked))
        if image is None and 'TIZEN_DISK' not in os.environ:
            raise ValueError('No image installed. Run tizen-ornn build.')
        if not explicit and 'TIZEN_DISK' not in os.environ:
            os.environ['TIZEN_SELECTION_LINK'] = str(selection_link(home))
        os.environ['TIZEN_OUT'] = str(image or home)
        run = SCRIPTS / 'run-vm.sh'
        command = [str(run)]
        if not headless:
            dependencies(build=False, gui=True)
            command.append('--gui')
        if getattr(args, 'host_browser', False):
            command.append('--host-browser')
        if getattr(args, 'no_host_network', False):
            command.append('--no-host-network')
        if getattr(args, 'share', None) is not None:
            command.extend(['--share', args.share])
        elif getattr(args, 'share_ro', None) is not None:
            command.extend(['--share-ro', args.share_ro])
        else:
            saved = getattr(args, 'saved_share', None)
            if saved is None:
                directory = Path(args.default_share)
                directory.mkdir(mode=0o700, parents=True, exist_ok=True)
                saved = str(directory)
            os.environ['TIZEN_ORNN_BOOT_SHARE'] = saved
        os.execv(run, command)
    if args.command == 'shutdown' and picked and any((picked / k).is_file() for k in ARM_KERNELS.values()):
        import socket
        lock = picked / 'build.lock'
        prefix = subprocess.check_output([SCRIPTS / 'vm-runtime', lock], text=True).strip()
        power_port = Path(prefix + '.shutdown.in')
        if power_port.is_fifo():
            fd = os.open(power_port, os.O_WRONLY | os.O_NONBLOCK)
            with os.fdopen(fd, 'wb') as port:
                port.write(b'poweroff\n')
        with socket.socket(socket.AF_UNIX) as client:
            client.settimeout(10)
            client.connect(prefix + '.power')
            with client.makefile('rwb') as stream:
                if 'QMP' not in json.loads(stream.readline()):
                    raise ValueError('Unexpected QEMU monitor greeting.')
                for op in ('qmp_capabilities', 'system_powerdown'):
                    stream.write(json.dumps({'execute': op}).encode() + b'\n')
                    stream.flush()
                    while reply := stream.readline():
                        message = json.loads(reply)
                        if 'error' in message:
                            raise ValueError(message['error']['desc'])
                        if 'return' in message:
                            break
                    else:
                        raise ValueError('QEMU monitor disconnected.')
        subprocess.run(['flock', '--shared', '--timeout', '90', lock, 'true'], check=True)
        return
    if args.command == 'shutdown':
        disk = str(disk_at(picked)) if picked else os.environ.get('TIZEN_DISK')
        if not disk:
            image = Path(explicit) if explicit else active_image(home)
            if image is None:
                raise ValueError('No image installed.')
            disk = str(disk_at(image))
        client = str(SCRIPTS / 'guest-command')
        os.execv(client, [client, disk, 'shutdown'])
    if os.environ.get('TIZEN_DISK') or os.environ.get('TIZEN_KERNEL'):
        raise ValueError('unset TIZEN_DISK and TIZEN_KERNEL to manage the selected image')
    if explicit and Path(explicit).resolve() != home:
        raise ValueError('choose either TIZEN_OUT or TIZEN_ORNN_HOME to manage images')
    if args.command == 'update' and args.names and not args.packages:
        raise ValueError('use update --packages with RPM names')
    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    if args.command in ('install', 'update') and args.packages:
        active = active_image(home)
        if args.command == 'update' and interactive:
            choices = update_choices(home)
            if choices:
                choice = choose_image(choices, 'update packages in', any((home / f'{arch}-headed/disk').is_dir() for arch in ARM_KERNELS))
                if choice is None:
                    return
                active = choice[1]
        if active is None:
            raise ValueError('No image installed. Run tizen-ornn build, then tizen-ornn run.')
        disk = str(disk_at(active))
        if args.command == 'install':
            command = [str(SCRIPTS / 'guest-command'), disk, 'install', *args.packages]
        else:
            version_args = ['--snapshot', args.snapshot] if args.snapshot else []
            command = [str(SCRIPTS / 'update-packages'), disk, *version_args, *args.names]
        os.execv(command[0], command)
    home.mkdir(mode=0o755, parents=True, exist_ok=True)
    with lock_file(home / '.tizen-management.lock', 'Another image installation or switch is in progress.', create=True):
        active = active_image(home)
        if args.command == 'delete':
            choices = deletable_images(home, args.arch)
            if args.image is None:
                if not interactive or not choices:
                    for arch, path in choices:
                        print(path.name, '(selected)' if path == active else '')
                    if interactive and not choices:
                        print('No managed disks to delete.')
                    return
                choice = choose_image(choices, 'delete')
                if choice is None:
                    return
            else:
                matches = [item for item in choices if item[1].name == args.image]
                if len(matches) != 1:
                    raise ValueError('Expected one managed image with that name. Use --arch to disambiguate.')
                choice = matches[0]
            arch, path = choice
            yes = args.yes and args.image is not None
            if arch in ARM_KERNELS:
                delete_arm(home, path, yes)
            else:
                delete_image(home, active, path.name, yes)
        elif args.command == 'rollback':
            rollback(home, active)
        elif args.command == 'build' and getattr(args, 'name', None):
            if not args.build_config:
                prepare(home, None, None, name=args.name, previous=active)
            else:
                with tempfile.NamedTemporaryFile(mode='w', suffix='.toml') as config:
                    config.write(args.build_config)
                    config.flush()
                    prepare(home, None, None, name=args.name, previous=active, config=Path(config.name))
        elif args.command in ('install', 'build') and active:
            dependencies(build=False)
            print(f'Existing image ready: {active}')
        elif args.command == 'update':
            if interactive:
                choices = update_choices(home)
                if choices:
                    choice = choose_image(choices, 'update', any((home / f'{arch}-headed/disk').is_dir() for arch in ARM_KERNELS))
                    if choice is None:
                        return
                    active = choice[1]
            prepare(home, active, args.snapshot or 'latest')
        else:
            prepare(home, active, None)


if __name__ == '__main__':
    try:
        execute(SimpleNamespace(**json.loads(sys.argv[1])))
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        sys.exit(f'tizen-ornn: {error}')
    except KeyboardInterrupt:
        sys.exit(130)
