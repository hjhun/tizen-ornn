#!/usr/bin/env bash
# Run the VM's serial console in a private tmux server so it survives detach.
set -euo pipefail

if [[ $1 == --pane ]]; then
    shift
    result=$1
    shift
    # Keep startup errors available even if QEMU exits before tmux's first draw.
    status=0
    exec 5> >(tee "$result.log" >&2)
    copier=$!
    "$@" 2>&5 5>&- || status=$?
    exec 5>&-
    wait "$copier" || :
    if (( status )); then
        printf '%s\n' "$status" > "$result"
    fi
    exit "$status"
fi

disk=$1
share_id=$2
host_network=$3
host_browser=$4
shift 4
command -v tmux >/dev/null || { echo 'Install tmux on the host to start a persistent console.' >&2; exit 1; }
self=$(realpath -- "$0")
prefix=$("${self%/*}/vm-runtime" "$disk")
tm=(tmux -S "$prefix.sock" -f "${self%/*}/console.tmux.conf")
unset TMUX TMUX_PANE
if [[ -z ${TERM:-} || $TERM == dumb ]]; then export TERM=xterm; fi

# Serialize creation and release the gate before waiting for interactive input.
exec 8>"$prefix.lock"
flock 8
result="$prefix.exit"
new=0
if ! "${tm[@]}" has-session -t '=vm' 2>/dev/null; then
    if ! flock -n "$disk" true; then
        echo "Tizen disk is already in use outside this console: $disk" >&2
        echo 'Stop the foreground VM or wait for the image operation to finish.' >&2
        exit 1
    fi
    rm -f -- "$result" "$result.log"
    : > "$result"
    : > "$result.log"
    new=1
else
    if (( host_browser )) && [[ $("${tm[@]}" show-environment -t '=vm' TIZEN_VM_HOST_BROWSER 2>/dev/null || :) != TIZEN_VM_HOST_BROWSER=1 ]]; then
        echo 'Shut down the guest and restart with --host-browser to enable browser access.' >&2
        exit 2
    fi
    if [[ -n $share_id ]]; then
        active_share=$("${tm[@]}" show-environment -t '=vm' TIZEN_VM_SHARE_ID 2>/dev/null || :)
        if [[ $active_share != "TIZEN_VM_SHARE_ID=$share_id" ]]; then
            echo 'The running VM has different share settings. Run systemctl poweroff in the guest to change them.' >&2
            exit 2
        fi
    fi
    if (( ! host_network )) && [[ $("${tm[@]}" show-environment -t '=vm' TIZEN_VM_HOST_NETWORK 2>/dev/null || :) == TIZEN_VM_HOST_NETWORK=1 ]]; then
        echo 'The running VM started with host network import enabled. Run systemctl poweroff in the guest before changing this option.' >&2
        exit 2
    fi
fi
# Keep this launch's diagnostics even if another VM starts immediately after it exits.
exec 6<"$result" 7<"$result.log"
status=0
if (( new )); then
    "${tm[@]}" new-session -d -s vm -n console -e "TIZEN_CONSOLE_SIZE=${TIZEN_CONSOLE_SIZE:-}" -e "TIZEN_VM_SHARE_ID=$share_id" -e "TIZEN_VM_HOST_NETWORK=$host_network" -e "TIZEN_VM_HOST_BROWSER=$host_browser" \
        -- "$self" --pane "$result" "$@" 6<&- 7<&- 8>&- || status=$?
fi
if (( status == 0 )); then
    # One observer follows tmux's effective pane size across all its clients.
    # It exits with the pane, independently of the client which started it.
    pane=$("${tm[@]}" display-message -p -t '=vm:' '#{pane_pid} #{pane_tty}') || pane=
    if [[ -n $pane ]]; then
        read -r pane_pid pane_tty <<< "$pane"
        "${self%/*}/console-size" "$disk" "$prefix" "$pane_pid" "$pane_tty" \
            </dev/null >/dev/null 2>&1 6<&- 7<&- 8>&- &
    fi
fi
exec 8>&-
if (( status == 0 )); then
    "${tm[@]}" attach-session -t '=vm' || status=$?
fi
if read -r failure <&6; then
    cat <&7 >&2
    status=$failure
fi
exit "$status"
